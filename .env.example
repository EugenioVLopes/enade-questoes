# Banco de dados local (PostgreSQL 16 via compose.yaml)
POSTGRES_USER=enade
POSTGRES_PASSWORD=enade
POSTGRES_DB=enade_questoes
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://enade:enade@localhost:5432/enade_questoes

# Diretório local de armazenamento de PDFs, mídias e cache (fora do Git)
DATA_DIR=./data/app

# Configuração do provedor de LLM multimodal (copie para .env e preencha sua chave)
# Nunca versione o arquivo .env (já ignorado no .gitignore).

# Opção recomendada para a v1: Google Gemini API (Google AI Studio — Free Tier)
# Obtenha sua chave gratuita em: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Configuração genérica da porta ClassificadorMultimodal (sobrescreve o padrão Gemini se preenchida)
LLM_PROVIDER=gemini_openai
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=   # opcional se GEMINI_API_KEY já estiver definida
LLM_MODEL=gemini-2.5-flash-lite
LLM_MAX_RPM=10
LLM_TIMEOUT_S=60
LLM_MAX_TOKENS=4096   # piso mínimo aplicado: 4096

# Exemplo futuro — Servidor próprio Qwen/vLLM (troca apenas por .env):
# LLM_PROVIDER=vllm_qwen
# LLM_BASE_URL=http://localhost:8005/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL=Qwen/Qwen3.8-27B
# LLM_MAX_RPM=0
